generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum SignatureType {
  DIGITAL_SIGNATURE
  APPROVAL_STAMP
  INITIALS
  METADATA_ONLY
}

enum LanguageCode {
  EN
  ES
  FR
  DE
  PT
  ZH
  AR
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
}

enum SystemRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  APPROVER
  REVIEWER
  SUBMITTER
}

enum DocumentStatus {
  DRAFT
  PENDING_APPROVAL
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  REVISION_REQUESTED
  EXPIRED
}

enum ContentType {
  RICH_TEXT
  UPLOADED_PDF
  UPLOADED_DOCX
  UPLOADED_XLSX
  UPLOADED_IMAGE
  UPLOADED_OTHER
}

enum WorkflowActionType {
  SEQUENTIAL
  PARALLEL
  ANY_OF
}

enum AuditAction {
  CREATED
  SUBMITTED
  APPROVED
  REJECTED
  REVISION_REQUESTED
  RESUBMITTED
  CANCELLED
  COMMENTED
  DELEGATED
  EXPIRED
  FILE_ATTACHED
  STEP_BYPASSED
  VIEWED
}

enum NotificationType {
  APPROVAL_REQUEST
  APPROVED
  REJECTED
  REVISION_REQUESTED
  REMINDER
  DELEGATED
  COMMENTED
  EXPIRED
  DOCUMENT_CANCELLED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum ThemeMode {
  light
  dark
  system
}

model DocumentSignature {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  documentId      String        @db.ObjectId
  approverId      String        @db.ObjectId
  signatureType   SignatureType @default(APPROVAL_STAMP)
  signatureData   String?       // Base64 encoded signature
  approvalStamp   String?       // Generated approval stamp HTML
  stampImageUrl   String?       // URL to stamp image
  signedAt        DateTime      @default(now())
  pageNumber      Int?
  positionX       Float?
  positionY       Float?
  width           Float?
  height          Float?
  metadata        Json?
  isVerified      Boolean       @default(false)
  verificationHash String?

  document        Document      @relation("DocumentSignatures", fields: [documentId], references: [id], onDelete: Cascade)
  approver        User          @relation("UserSignatures", fields: [approverId], references: [id])

  @@map("document_signatures")
}

model ApprovalMetadata {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  documentId      String        @db.ObjectId
  approverId      String        @db.ObjectId
  approvalDate    DateTime      @default(now())
  approvalText    String
  statusText      String
  ipAddress       String?
  userAgent       String?
  deviceInfo      String?
  approverFullName String?
  approverEmail   String?
  approverDepartment String?
  organizationName String?

  document        Document      @relation("ApprovalMetadata", fields: [documentId], references: [id], onDelete: Cascade)
  approver        User          @relation("UserApprovalMetadata", fields: [approverId], references: [id])

  @@map("approval_metadata")
}

model UserLanguagePreference {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  userId          String        @db.ObjectId @unique
  language        LanguageCode  @default(EN)
  timezone        String        @default("UTC")
  dateFormat      String        @default("MM/DD/YYYY")
  timeFormat      String        @default("12H")
  theme           ThemeMode     @default(dark)
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_language_preferences")
}

model EmailLog {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  recipientId     String?       @db.ObjectId
  recipientEmail  String
  subject         String
  template        String
  status          EmailStatus   @default(PENDING)
  sentAt          DateTime?
  failureReason   String?
  errorCode       String?
  retryCount      Int           @default(0)
  maxRetries      Int           @default(3)
  metadata        Json?
  documentId      String?       @db.ObjectId
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  recipient       User?         @relation("EmailsSent", fields: [recipientId], references: [id], onDelete: SetNull)
  document        Document?     @relation("EmailLogs", fields: [documentId], references: [id], onDelete: SetNull)

  @@map("email_logs")
}

model AuditTrail {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  userId          String?       @db.ObjectId
  action          String
  resourceType    String
  resourceId      String?
  changes         Json?
  ipAddress       String?
  userAgent       String?
  status          String        @default("SUCCESS")
  errorMessage    String?
  metadata        Json?
  createdAt       DateTime      @default(now())

  user            User?         @relation("AuditTrails", fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_trails")
}
model Organization {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String   @unique
  logoUrl   String?
  settings  Json     @default("{}")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  departments       Department[]
  approvalTemplates ApprovalTemplate[]
  documents         Document[]
  customRoles       CustomRole[]

  @@map("organizations")
}

model Department {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  description    String?
  organizationId String  @db.ObjectId
  parentId       String? @db.ObjectId
  headUserId     String? @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Department?  @relation("DeptHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children     Department[] @relation("DeptHierarchy")
  users        User[]

  @@map("departments")
}

model User {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  email          String     @unique
  emailVerified  DateTime?
  passwordHash   String?
  image          String?
  systemRole     SystemRole @default(SUBMITTER)
  organizationId String?    @db.ObjectId
  departmentId   String?    @db.ObjectId
  managerId      String?    @db.ObjectId
  jobTitle       String?
  languagePreference UserLanguagePreference?
  signatures          DocumentSignature[]    @relation("UserSignatures")
  approvalMetadata    ApprovalMetadata[]     @relation("UserApprovalMetadata")
  emailsSent          EmailLog[]             @relation("EmailsSent")
  auditTrails         AuditTrail[]           @relation("AuditTrails")
  isActive       Boolean    @default(true)
  lastLoginAt    DateTime?
  preferences    Json       @default("{}")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  uploadedFiles  DocumentFile[]

  organization        Organization?    @relation(fields: [organizationId], references: [id])
  department          Department?      @relation(fields: [departmentId], references: [id])
  manager             User?            @relation("UserHierarchy", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reports             User[]           @relation("UserHierarchy")
  submittedDocuments  Document[]       @relation("DocSubmitter")
  assignedSteps       WorkflowStep[]   @relation("StepAssignee")
  auditLogs           AuditLog[]
  notifications       Notification[]
  sessions            Session[]
  accounts            Account[]
  customRoleUsers     CustomRoleUser[]
  delegationsGiven    Delegation[]     @relation("DelegationFrom")
  delegationsReceived Delegation[]     @relation("DelegationTo")
  approvalActions     ApprovalAction[]
  invitesSent         UserInvite[]     @relation("InviteSender")
  comments            Comment[]

  @@map("users")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model CustomRole {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String   @db.ObjectId
  name           String
  description    String?
  permissions    String[]
  color          String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users         CustomRoleUser[]
  workflowSteps WorkflowStep[]

  @@unique([organizationId, name])
  @@map("custom_roles")
}

model CustomRoleUser {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  customRoleId String   @db.ObjectId
  assignedAt   DateTime @default(now())
  assignedBy   String?  @db.ObjectId

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole CustomRole @relation(fields: [customRoleId], references: [id], onDelete: Cascade)

  @@unique([userId, customRoleId])
  @@map("custom_role_users")
}

model ApprovalTemplate {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String   @db.ObjectId
  name           String
  description    String?
  category       String?
  isActive       Boolean  @default(true)
  isDefault      Boolean  @default(false)
  slaHours       Int?
  createdById    String   @db.ObjectId
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        WorkflowStep[]
  documents    Document[]

  @@unique([organizationId, name])
  @@map("approval_templates")
}

model WorkflowStep {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  templateId        String             @db.ObjectId
  stepOrder         Int
  name              String
  description       String?
  actionType        WorkflowActionType @default(SEQUENTIAL)
  assignedUserId    String?            @db.ObjectId
  customRoleId      String?            @db.ObjectId
  useManagerOf      Boolean            @default(false)
  useDepartmentHead Boolean            @default(false)
  isRequired        Boolean            @default(true)
  timeoutHours      Int?
  canDelegate       Boolean            @default(true)
  requiresComment   Boolean            @default(false)
  createdAt         DateTime           @default(now())

  template     ApprovalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  assignedUser User?            @relation("StepAssignee", fields: [assignedUserId], references: [id])
  customRole   CustomRole?      @relation(fields: [customRoleId], references: [id])

  @@unique([templateId, stepOrder])
  @@map("workflow_steps")
}

model Document {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  organizationId   String         @db.ObjectId
  title            String
  description      String?
  content          String?
  contentJson      Json?
  contentType      ContentType    @default(RICH_TEXT)
  templateId       String?        @db.ObjectId
  submittedById    String         @db.ObjectId
  department       String?
  tags             String[]
  status           DocumentStatus @default(DRAFT)
  currentStepIndex Int            @default(0)
  workflowSnapshot Json?
  priority         String         @default("NORMAL")
  dueDate          DateTime?
  version          Int            @default(1)
  isConfidential   Boolean        @default(false)
  signatures       DocumentSignature[] @relation("DocumentSignatures")
  approvalMetadata ApprovalMetadata[]  @relation("ApprovalMetadata")
  emailLogs        EmailLog[]          @relation("EmailLogs")
  expiresAt        DateTime?
  submittedAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id])
  template      ApprovalTemplate? @relation(fields: [templateId], references: [id])
  submittedBy   User              @relation("DocSubmitter", fields: [submittedById], references: [id])
  files         DocumentFile[]
  auditLogs     AuditLog[]
  notifications Notification[]
  actions       ApprovalAction[]
  versions      DocumentVersion[]
  comments      Comment[]

  @@map("documents")
}

model DocumentFile {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId  String   @db.ObjectId
  fileName    String
  fileSize    Int
  fileType    String
  fileUrl     String
  uploadedBy  String?  @db.ObjectId
  uploader    User?    @relation(fields: [uploadedBy], references: [id])
  uploadedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([documentId])
  @@index([uploadedBy])
}

model DocumentVersion {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  documentId  String   @db.ObjectId
  version     Int
  title       String
  content     String?
  contentJson Json?
  snapshot    Json
  createdById String   @db.ObjectId
  createdAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@map("document_versions")
}

model ApprovalAction {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  documentId    String      @db.ObjectId
  stepIndex     Int
  actorId       String      @db.ObjectId
  action        AuditAction
  comment       String?
  attachmentUrl String?
  ipAddress     String?
  userAgent     String?
  timestamp     DateTime    @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actor    User     @relation(fields: [actorId], references: [id])

  @@map("approval_actions")
}

model Comment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  documentId String   @db.ObjectId
  authorId   String   @db.ObjectId
  content    String
  parentId   String?  @db.ObjectId
  isInternal Boolean  @default(false)
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author   User      @relation(fields: [authorId], references: [id])
  parent   Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies  Comment[] @relation("CommentThread")

  @@map("comments")
}

model AuditLog {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  documentId String      @db.ObjectId
  actorId    String      @db.ObjectId
  action     AuditAction
  details    Json?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime    @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actor    User     @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

model Notification {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  recipientId String           @db.ObjectId
  documentId  String?          @db.ObjectId
  type        NotificationType
  title       String
  message     String
  data        Json?
  isRead      Boolean          @default(false)
  readAt      DateTime?
  emailSent   Boolean          @default(false)
  createdAt   DateTime         @default(now())

  recipient User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  document  Document? @relation(fields: [documentId], references: [id])

  @@map("notifications")
}

model Delegation {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  fromUserId String   @db.ObjectId
  toUserId   String   @db.ObjectId
  documentId String?  @db.ObjectId
  reason     String?
  startsAt   DateTime @default(now())
  expiresAt  DateTime
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  fromUser User @relation("DelegationFrom", fields: [fromUserId], references: [id])
  toUser   User @relation("DelegationTo", fields: [toUserId], references: [id])

  @@map("delegations")
}

model UserInvite {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  email          String
  organizationId String       @db.ObjectId
  systemRole     SystemRole   @default(SUBMITTER)
  invitedById    String       @db.ObjectId
  token          String       @unique
  status         InviteStatus @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  invitedBy User @relation("InviteSender", fields: [invitedById], references: [id])

  @@map("user_invites")
}
